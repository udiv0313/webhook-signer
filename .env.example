# Copy this file to .env and fill in real values. Never commit .env.
# No spaces around "=".

# Port the server listens on. Default: 3000.
PORT=3000

# Master secret. Each endpoint's signing secret is derived from it (HKDF-SHA256),
# so this is the only secret you need to keep. Never returned by the API or logged.
# Generate a real one with:  openssl rand -hex 32
# The server refuses to start with this placeholder value.
WEBHOOK_SECRET=your_secret_here

# How many seconds a webhook timestamp may differ from the server's clock,
# in either direction, before the request is rejected. Default: 300 (5 minutes).
WEBHOOK_TOLERANCE_SECONDS=300

# Largest request body accepted, in bytes. Bigger bodies get 413 and are never
# verified. Default: 1048576 (1 MB).
WEBHOOK_MAX_BODY_SIZE=1048576

# Lets the web UI send test webhooks: the server signs them (the browser never
# sees a secret) and delivers them to itself. Only accepts requests from this
# machine. Leave false anywhere other people can reach the server. Default: false.
WEBHOOK_TEST_SENDER_ENABLED=true

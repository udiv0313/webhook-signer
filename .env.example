# Copy this file to .env and fill in real values. Never commit .env.
# No spaces around "=".

# Port the server listens on. Default: 3000.
PORT=3000

# Master secret. Encrypts every endpoint's signing secret in the database, so a
# copy of the database alone reveals no secrets. Never returned by the API or
# logged. Changing it makes existing endpoint secrets unreadable: rotate them.
# Generate a real one with:  openssl rand -hex 32
# The server refuses to start with this placeholder value.
WEBHOOK_SECRET=your_secret_here

# How many seconds a webhook timestamp may differ from the server's clock,
# in either direction, before the request is rejected. Default: 300 (5 minutes).
WEBHOOK_TOLERANCE_SECONDS=300

# Largest request body accepted, in bytes. Bigger bodies get 413 and are never
# verified. Default: 1048576 (1 MB).
WEBHOOK_MAX_BODY_SIZE=1048576

# SQLite database file, created on first start (with its folder). Relative paths
# are relative to where you run `npm start`. Default: data/webhook-signer.db
DATABASE_PATH=data/webhook-signer.db

# How long a browser's workspace (its endpoints and events) lives after it was
# created. It is never extended; afterwards it is deleted. Default: 72.
WORKSPACE_TTL_HOURS=72

# How many of the newest events are kept per endpoint. Older ones are deleted.
# Default: 50.
WEBHOOK_MAX_EVENTS_PER_ENDPOINT=50

# How many endpoints one workspace (browser) may have. Default: 20.
WORKSPACE_MAX_ENDPOINTS=20

# Set to true only when the server runs behind exactly one reverse proxy that
# sets X-Forwarded-For. The client IP (used for rate limits) is then taken from
# that header; otherwise every request would look like it came from the proxy.
# Leave false when clients connect directly: they could fake the header.
TRUST_PROXY=false

# Adds the Secure flag to the workspace cookie, so browsers only send it over
# HTTPS. Set to true when the site is served over HTTPS. Default: false.
COOKIE_SECURE=false

# Lets the web UI send test webhooks: the server signs them with the endpoint's
# secret and delivers them to itself. Only works for endpoints in the caller's
# own workspace, and is rate limited, so it is safe to enable publicly.
# Default: false.
WEBHOOK_TEST_SENDER_ENABLED=true

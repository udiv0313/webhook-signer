# Frontend configuration. Copy to frontend/.env to change the defaults.
#
# IMPORTANT: every VITE_* variable is bundled into the browser JavaScript and is
# PUBLIC. Anyone who opens the page can read it. Never put WEBHOOK_SECRET or any
# other secret in this file.

# Base URL that webhook senders should POST to. Only used to DISPLAY webhook URLs
# in the UI (e.g. http://localhost:3000/api/webhooks/ep_...).
# Default: http://localhost:3000 in development; in a production build, the
# address the page was loaded from. Usually leave it unset.
# VITE_WEBHOOK_BASE_URL=http://localhost:3000

# Where the Vite dev server forwards /api requests. Read only by vite.config.js
# (no VITE_ prefix), so it never reaches the browser. Default shown.
API_PROXY_TARGET=http://localhost:3000
